      "description": "KSG Mutual Information estimator with special.digamma bias correction",
      "formula": "A_c = integral_{z_ini}^{0} I[rho(x,tau); rho(x,tau+Delta_tau)] dtau",
      "estimator": "Kraskov-Stogbauer-Grassberger k-NN",
      "k_neighbors": [
        2,
        6,
        10
      ],
      "grid_resolution": 128,
      "time_step_myr": 50,
      "min_halo_mass_msun": 100000000000.0,
      "entropy_formula": "H_k(X) = psi(N) - psi(k) + log(c_d) + (d/N) * sum(log(epsilon(i)))",
      "validation_accuracy": "<2% against analytical Gaussian fields",
      "measured_values": {
        "null_mean_bits": 62.1,
        "null_sigma_bits": 8.4,
        "cloud9_measured_bits": 87.3,
        "cloud9_systematic_bits": 3.2,
        "z_score": 2.99,
        "p_value": 0.0014,
        "confidence_percent": 99.86,
        "v112_adjusted_bits": 266.3,
