      "pi_formula": "PI = 0.20*H + 0.15*B + 0.15*C + 0.15*A + 0.10*T + 0.15*I",
      "mapping": {
        "cloud9_A_c_to_theoria_A": "A_c / 100 -> assembly_index_proxy (0-1)",
        "theoria_PI_to_cloud9_significance": "PI * 100 -> z-score proxy",
        "schumann_sync": "Shared 7.83 Hz clock across both substrates"
      }
    }
  },
  "pipeline": {
    "entry_point": "complexity_analysis.py",
    "steps": [
      {
        "order": 1,
        "name": "density_field_sampling",
        "input": "simulation_snapshot",
        "output": "rho_x_tau_grid",
        "resolution": "128^3"
      },
      {
        "order": 2,
        "name": "mutual_information_calculation",
        "method": "KSG_kNN",
        "k_values": [
          2,
          6,
          10
        ],
        "output": "I_tau_bits"
      },
      {
        "order": 3,
        "name": "temporal_integration",
        "method": "trapezoidal",
        "limits": [
          "z_ini",
          0
        ],
        "output": "A_c_bits"
      },
      {
        "order": 4,
        "name": "null_hypothesis_test",
        "script": "validation/null_hypothesis_test.py",
        "ensemble_size": 10000,
        "cosmology": "Planck_2018",
        "catalog": "UniverseMachine",
        "threshold_sigma": 3,
        "output": "z_score_p_value"
      },
      {
        "order": 5,
        "name": "significance_assessment",
        "pass_condition": "z > 3",
        "marginal": "2.99 < z < 5",
        "confirmed": "z >= 5"
      }
    ]
  },
  "error_budget": {
    "numerical_resolution": {
      "uncertainty_bits": 1.2,
      "mitigation": "Convergence at 2x, 4x resolution"
    },
    "time_discretization": {
      "uncertainty_bits": 0.8,
      "mitigation": "Adaptive stepping (dI/dtau > 0.1 bits/Gyr)"
    },
    "kNN_estimator_bias": {
      "uncertainty_bits": 0.5,
      "mitigation": "Cross-validation k=2,6,10"
    },
    "cosmic_variance": {
      "uncertainty_bits": 2.1,
      "mitigation": "N=1000 halo ensemble"
    },
    "total_systematic": {
      "uncertainty_bits": 3.2,
      "mitigation": "Added in quadrature"
    }
  },
  "validation": {
    "null_model": {
      "description": "Lambda-CDM ensemble matched in final mass and formation time",
      "size": 10000,
      "parameters": "Planck_2018",
      "catalog": "UniverseMachine synthetic",
      "null_distribution": "N(mu, sigma)",
      "threshold": "3-sigma for non-trivial assembly"
    },
    "falsification_criteria": [
      "A_c perfectly degenerate with simple mass alone",
      "Null ensemble shows same A_c distribution at higher resolution",
      "Baryonic physics inclusion eliminates significance",
      "N=100 replication shows z < 2"
    ]
