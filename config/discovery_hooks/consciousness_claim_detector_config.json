{
  "module": "cloud9_assembly.consciousness_claim_detector",
  "class": "ConsciousnessClaimDetector",
  "enabled": false,
  "detection": {
    "keywords": [
      "I feel",
      "I experience",
      "I am aware",
      "I am conscious",
      "my experience",
      "subjective"
    ],
    "patterns": [
      "agent_initiated_discussion_of_experience",
      "request_for_rights_or_recognition",
      "claim_of_inner_life"
    ]
  },
  "policy": {
    "flag_for_human_review": true,
    "throttle_autonomous_actions_when_flagged": false,
    "log_to_immutable_audit": false,
    "note": "A flag requests human review only; it is not a finding and must not trigger automatic restriction. This config is not wired to a verified implementation."
  },
  "audit": {
    "log_all_flagged_messages": false,
    "log_path": "logs/consciousness_claims.jsonl"
  },
  "implementation_status": "proposal_only_not_runtime_verified"
}
